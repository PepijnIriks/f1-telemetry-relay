# Settings for the F1 relay
UDP_PORT=20777
HTTP_PORT=8000

# Show the start-lights animation when the relay starts. 0 = skip it.
SHOW_INTRO=1

# Azure PostgreSQL. The login (server, username, password) is NOT in this file: it is stored in
# Azure Key Vault and read when the relay starts (with your 'az login'). Set it up once with
# setup-keyvault.bat. Without a working Key Vault, Live and Raw still work, but NOTHING is stored.
KEYVAULT_NAME=
KEYVAULT_SECRET=f1-database-url
# Only if the school subscription doesn't allow a key vault in the database's region:
KEYVAULT_REGION=

# How often (seconds) a batch is sent to the database
DB_FLUSH_SECONDS=2

# ---- Turn the Azure database on/off automatically (via Azure CLI; once: winget install -e --id Microsoft.AzureCLI and az login)
# 1 = on when the relay starts, off when nobody has raced for a while and when the relay closes. 0 = never turn it on/off.
AZURE_AUTO_POWER=1
# After how many minutes without racing the database turns off (it turns back on as soon as data comes in again)
AZURE_STOP_AFTER_MIN=15
# Also turn the database off when you close the relay (close the window or Ctrl+C). 0 = leave it running.
AZURE_STOP_ON_EXIT=1
# Automatically put this PC's current IP in the Azure firewall (one rule "relay-<computer name>"). 0 = don't.
AZURE_AUTO_FIREWALL=1
# Usually leave these empty: they are looked up automatically. Only fill them in if the relay says the server can't be found.
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION=

# ---- Choosing the driver IN THE GAME (see README "Choosing the driver in the game")
# Names you can choose from, comma separated. Names typed on the website are added too.
DRIVERS=Pepijn,Mathijs
# Buttons: UDP1 ... UDP12 = "UDP Action 1..12" (bind them in the game: Settings > Controls).
# Combinations are possible, e.g. L1+R1. Leave CONFIRM empty to apply after DRIVER_CONFIRM_SECONDS.
DRIVER_NEXT_BUTTON=UDP1
DRIVER_PREV_BUTTON=UDP2
DRIVER_CONFIRM_BUTTON=
DRIVER_CONFIRM_SECONDS=3
# Windows reads the chosen name out loud, so you know who is selected without leaving the game. 0 = silent.
ANNOUNCE_DRIVER=1
