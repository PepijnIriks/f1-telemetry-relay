# Settings for the F1 relay
UDP_PORT=20777
HTTP_PORT=8000
# Who may reach the relay. 127.0.0.1 = only this PC (safe: nobody else on the wifi can see the website
# or change the driver). 0.0.0.0 = every device on the network (e.g. to watch on a phone or tablet).
WEB_HOST=127.0.0.1
# The game runs on this PC, so telemetry only comes in from 127.0.0.1. Use 0.0.0.0 if the game runs elsewhere.
UDP_HOST=127.0.0.1

# Show the start-lights animation when the relay starts. 0 = skip it.
SHOW_INTRO=1

# Database: PostgreSQL on the Fontys Educloud VM (set up with server/install-educloud.sh).
# The login (address, username, password) is NOT in this file: it is stored in the Windows Credential Manager
# of each PC (start.bat asks for it the first time, or tools.bat > Database login).
# Without a login, Live and Raw still work, but NOTHING is stored.

# How often (seconds) a batch is sent to the database
DB_FLUSH_SECONDS=2

# ---- Storage: every packet is stored, nothing is ever removed.
# Size of the VM's disk in GB (used by tools.bat > Compress the database, so it never fills the disk).
DB_STORAGE_GB=64
# Warning (black window + website) when the database gets bigger than this many GB (keep it well below the
# VM's disk size: a full disk stops PostgreSQL). 0 = no warning.
DB_WARN_GB=45

# ---- Choosing the driver (website buttons, the "F1 driver" window, or a number in the black window)
# Names to choose from, comma separated. Names added on the website / in the window are remembered too
# (in config/drivers.json).
DRIVERS=Pepijn,Mathijs
# Open the small "F1 driver" menu window next to the relay. 0 = don't.
DRIVER_MENU=1
